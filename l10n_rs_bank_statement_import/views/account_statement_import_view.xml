<odoo>
    <!-- account.menu_finance_entries is hidden in Community unless the user has
         account.group_account_readonly.  Keep the OCA import action reachable
         for regular Invoicing users by placing it directly below Invoicing. -->
    <record
        id="account_statement_import_file.account_statement_import_menu"
        model="ir.ui.menu"
    >
        <field name="parent_id" ref="account.menu_finance" />
    </record>

    <menuitem
        id="menu_bank"
        name="Bank"
        parent="account.menu_finance_configuration"
        sequence="50"
        groups="account.group_account_manager"
    />
    <menuitem
        id="menu_bank_accounts"
        name="Accounts"
        parent="menu_bank"
        action="base.action_res_partner_bank_account_form"
        sequence="10"
        groups="account.group_account_manager"
    />

    <record id="account_statement_import_form" model="ir.ui.view">
        <field name="model">account.statement.import</field>
        <field
            name="inherit_id"
            ref="account_statement_import_file.account_statement_import_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//ul[@id='statement_format']" position="inside">
                <li>Alta Banka Business e-banking daily statement (.xls)</li>
                <li>Halcom Hal E-Bank statement (.txt, also as a ZIP with the _cov recap)</li>
                <li>Asseco OfficeBanking / FX Client statement (.xml)</li>
                <li>Raiffeisen OnLine (ROL) / OTP statement (.xml)</li>
            </xpath>
        </field>
    </record>
</odoo>
