<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="RacunPrivredaIzvod">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Zaglavlje"/>
        <xs:element maxOccurs="unbounded" ref="Stavke"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Zaglavlje">
    <xs:complexType>
      <xs:attribute name="BrojIzvoda" use="required" type="xs:string"/>
      <xs:attribute name="DatumIzvoda" use="required" type="xs:string"/>
      <xs:attribute name="DatumPrethodnogIzvoda" use="required" type="xs:string"/>
      <xs:attribute name="DugovniPromet" use="required" type="xs:decimal"/>
      <xs:attribute name="IBANBroj" use="required" type="xs:string"/>
      <xs:attribute name="IzvodID" use="required" type="xs:string"/>
      <xs:attribute name="KomitentAdresa" use="required" type="xs:string"/>
      <xs:attribute name="KomitentDeviznoKnjigovodstvo" use="required" type="xs:string"/>
      <xs:attribute name="KomitentMesto" use="required" type="xs:string"/>
      <xs:attribute name="KomitentNaziv" use="required" type="xs:string"/>
      <xs:attribute name="Konto" use="required" type="xs:string"/>
      <xs:attribute name="MaticniBroj" use="required" type="xs:string"/>
      <xs:attribute name="MaticniBrojBanke" use="required" type="xs:string"/>
      <xs:attribute name="MaticniBrojBi" use="required" type="xs:string"/>
      <xs:attribute name="NovoStanje" use="required" type="xs:decimal"/>
      <xs:attribute name="OrgJedinica" use="required" type="xs:string"/>
      <xs:attribute name="OznakaValute" use="required" type="xs:string"/>
      <xs:attribute name="Partija" use="required" type="xs:string"/>
      <xs:attribute name="PotrazniPromet" use="required" type="xs:string"/>
      <xs:attribute name="PrethodnoStanje" use="required" type="xs:decimal"/>
      <xs:attribute name="SifraValute" use="required" type="xs:string"/>
      <xs:attribute name="SkracenaPartija" use="required" type="xs:string"/>
      <xs:attribute name="TekstPoruke" use="required" type="xs:string"/>
      <xs:attribute name="TipRacuna" use="required" type="xs:string"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Stavke">
    <xs:complexType>
      <xs:attribute name="BrojKredita" use="required" type="xs:string"/>
      <xs:attribute name="BrojZaReklamaciju" use="required" type="xs:string"/>
      <xs:attribute name="DatumObrade" use="required" type="xs:string"/>
      <xs:attribute name="DatumValute" use="required" type="xs:string"/>
      <xs:attribute name="DinarskaProtivvrednost" use="required" type="xs:decimal"/>
      <xs:attribute name="Duguje" use="required" type="xs:decimal"/>
      <xs:attribute name="GodinaKredita" use="required" type="xs:string"/>
      <xs:attribute name="GodinaStatistika" use="required" type="xs:string"/>
      <xs:attribute name="InoTrosak" use="required" type="xs:string"/>
      <xs:attribute name="IznosStatistika" use="required" type="xs:string"/>
      <xs:attribute name="KontrolnikStatistika" use="required" type="xs:string"/>
      <xs:attribute name="NalogKorisnik" use="required" type="xs:string"/>
      <xs:attribute name="Napomena" use="required" type="xs:string"/>
      <xs:attribute name="NominalniIznosPriliva" use="required" type="xs:string"/>
      <xs:attribute name="Opis" use="required" type="xs:string"/>
      <xs:attribute name="OsnovPlacanja" use="required" type="xs:string"/>
      <xs:attribute name="Potrazuje" use="required" type="xs:integer"/>
      <xs:attribute name="ProvizijaInoBanke" use="required" type="xs:string"/>
      <xs:attribute name="RacunNalogodavacKorisnik" use="required" type="xs:string"/>
      <xs:attribute name="Referenca" use="required" type="xs:string"/>
      <xs:attribute name="SifraObrasca" use="required" type="xs:string"/>
      <xs:attribute name="TekstOsnova" use="required" type="xs:string"/>
      <xs:attribute name="TekstStatistike" use="required" type="xs:string"/>
      <xs:attribute name="TipDetalja" use="required" type="xs:string"/>
      <xs:attribute name="TipTransakcije" use="required" type="xs:string"/>
      <xs:attribute name="TrazeniDatumValute" use="required" type="xs:string"/>
      <xs:attribute name="VasBrojNaloga" use="required" type="xs:string"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
